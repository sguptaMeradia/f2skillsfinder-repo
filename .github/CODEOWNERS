/.github/                           @your-org/skills-platform
/scripts/                           @your-org/skills-platform
/.claude-plugin/                    @your-org/skills-platform

# One line per plugin: its named owner(s).
/plugins/example-plugin/            @your-github-handle @your-org/skills-platform
